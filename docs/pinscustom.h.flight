//========================================
//				Gyro Pins Pins
//========================================
// Names used during Fred's Bitbanging
// Should match pin_selects above.
#define SDI1 						PIN_D9	
#define SDO1 						PIN_D8
#define SCK1OUT 					PIN_D10

// Development Board Settings
#define GYROCS1 					PIN_B10
#define GYROCS2 					PIN_B11
#define GYROCS3 					PIN_B15

// Gyro Power Pin
#define GYRO_ON						PIN_A1

//========================================
//				IMI-100 Pins
//========================================
#define IMI_PWR 					PIN_E8 //H2.18

//=====================================
// 				I2C
//=====================================
#define I2C_ON						PIN_E5
#define Device_SDA 					PIN_G3
#define Device_SCL 					PIN_G2

//========================================
//  		    Enable USB Serial
//========================================
#define USB_OE						PIN_C1

//========================================
//				Flash Pins
//========================================
#define FLASH_CHIP_SELECT			PIN_D13			
#define FLASH_WRITE_PROTECT			PIN_D6			
